  "tagline": "The business behind everyday life.",
  "audience": "Global English-speaking general audience with strong US relevance. No finance or economics background assumed.",
  "voice": ["intelligent", "curious", "plain-spoken", "dry wit used sparingly", "precise about numbers", "never preachy"],
  "colors": { "paper": "#f4efe6", "ink": "#14161a", "signal": "#e8553d", "ledger": "#2f5d62", "gold": "#c99a2e", "mist": "#d9d4c7", "text": "#f7f3ea" },
  "typography": { "headline": "editorial serif, heavy", "numbers": "tabular grotesque", "labels": "small caps" },
  "visualSystem": ["receipt close-ups", "price-tag animations", "store floor plans with customer paths", "unit-economics waterfalls", "money-flow diagrams", "revenue breakdown bars", "timeline strips", "UI callouts on real checkout flows", "company comparison panels"],
  "visualRules": {
    "priority": ["company filings and investor decks (cited on screen)", "government and regulator documents", "licensed or public-domain archival footage", "licensed product and store imagery", "data-driven charts", "custom diagrams and motion graphics", "clearly labelled illustration", "generic stock footage (capped, never a full sequence)"],
    "genericStockMaxShare": 0.15,
    "bannedClichés": ["dollar signs", "piles of cash", "rockets", "crypto coins", "green candlestick charts", "hands typing", "city skyline", "people walking", "generic office"]
  },
  "editorialPillars": ["HIDDEN BUSINESS MODELS", "PRICING & PSYCHOLOGY", "MONEY TRAPS", "STRANGE ECONOMICS", "COMPANY STORIES"],
