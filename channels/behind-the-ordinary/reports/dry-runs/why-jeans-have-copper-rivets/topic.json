  "facts": [
    {
      "role": "origin",
      "layer": "VERIFIED FACT",
      "claim": "Jacob Davis pioneered rivets on work trousers in 1871 while working as a tailor in Reno, Nevada.",
      "quote": "Jacob Davis pioneered rivets while working as a tailor in Reno",
      "source": "Levi Strauss & Co. Archives — Those Oft-Forgotten Pant Parts",
      "url": "https://www.levistrauss.com/2014/04/17/those-oft-forgotten-pant-parts/"
    },
    {
      "role": "origin",
      "layer": "VERIFIED FACT",
      "claim": "Davis had originally used rivets on horse blankets.",
      "quote": "Davis had originally used rivets on horse blankets",
      "source": "Levi Strauss & Co. Archives — Those Oft-Forgotten Pant Parts",
      "url": "https://www.levistrauss.com/2014/04/17/those-oft-forgotten-pant-parts/"
    },
    {
      "role": "problem",
      "layer": "VERIFIED FACT",
      "claim": "Rivets reinforced stress points such as back-pocket corners and the crotch, which often tore apart under heavy wear.",
      "quote": "particularly the corners of the back pockets and the crotch, which often tore apart when exposed to heavy duty wear and tear",
      "source": "Levi Strauss & Co. Archives — Those Oft-Forgotten Pant Parts",
      "url": "https://www.levistrauss.com/2014/04/17/those-oft-forgotten-pant-parts/"
    },
    {
      "role": "explanation",
      "layer": "VERIFIED FACT",
      "claim": "Davis did not have the money to patent the technique, so he asked Levi Strauss to apply with him.",
      "quote": "Since Davis did not have the money required to patent the technique of using rivets",
      "source": "Levi Strauss & Co. Archives — Those Oft-Forgotten Pant Parts",
      "url": "https://www.levistrauss.com/2014/04/17/those-oft-forgotten-pant-parts/"
    },
    {
      "role": "origin",
      "layer": "VERIFIED FACT",
      "claim": "In 1873 the pair received a patent for an improvement in fastening pocket openings.",
      "quote": "the pair received a patent for “improvement in fastening pocket-openings.”",
      "source": "Levi Strauss & Co. Archives — Those Oft-Forgotten Pant Parts",
      "url": "https://www.levistrauss.com/2014/04/17/those-oft-forgotten-pant-parts/"
    },
    {
      "role": "explanation",
      "layer": "VERIFIED FACT",
      "claim": "Copper rivets kept pockets from ripping and made the openings stronger.",
      "quote": "Copper rivets kept the pockets from ripping and made the openings stronger and more secure",
      "source": "Levi Strauss & Co. Archives — Pockets Full of History",
      "url": "https://www.levistrauss.com/2017/01/12/pockets-full-history/"
    },
    {
      "role": "surprising-detail",
      "layer": "VERIFIED FACT",
      "claim": "In 1937 Levi's began covering back-pocket rivets because the copper points scratched furniture and saddles.",
      "quote": "many had issues with the copper points scratching furniture and saddles",
      "source": "Levi Strauss & Co. Archives — Pockets Full of History",
      "url": "https://www.levistrauss.com/2017/01/12/pockets-full-history/"
    },
    {
      "role": "consequence",
      "layer": "VERIFIED FACT",
      "claim": "The covered back-pocket rivets were dropped altogether by 1966 because they wore through the denim.",
