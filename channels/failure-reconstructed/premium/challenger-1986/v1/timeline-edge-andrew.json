 "lines": [
  {
   "id": "L1",
   "beat": "B1",
   "text": "Less than a second after liftoff, Challenger was already leaking.",
   "start": 0.06,
   "end": 3.466
  },
  {
   "id": "L2",
   "beat": "B2",
   "text": "Smoke was puffing from a joint on the right booster, sealed by two rubber O-rings.",
   "start": 4.046,
   "end": 8.752
  },
  {
   "id": "L3",
   "beat": "B2",
   "text": "That morning was fifteen degrees colder than any launch before.",
   "start": 9.156,
   "end": 12.416
  },
  {
   "id": "L4",
   "beat": "B2",
   "text": "And cold rubber springs back slowly.",
   "start": 12.833,
   "end": 14.622
  },
  {
   "id": "L5",
   "beat": "B2",
   "text": "So when ignition flexed the joint open, the O-rings couldn't keep up, and hot gas blew past them.",
   "start": 15.026,
   "end": 20.321
  },
  {
   "id": "L6",
   "beat": "B2",
   "text": "Then the smoke stopped, and Challenger flew on.",
   "start": 20.725,
   "end": 23.053
  },
  {
   "id": "L7",
   "beat": "B2",
   "text": "Fifty-eight seconds in, a flame broke through and swept onto the external fuel tank.",
   "start": 23.519,
   "end": 28.323
  },
  {
   "id": "L8",
   "beat": "B3",
   "text": "At seventy-three seconds, the tank failed, and Challenger broke apart.",
   "start": 29.043,
   "end": 33.01
  },
  {
   "id": "L9",
   "beat": "B4",
   "text": "All seven crew members were lost.",
   "start": 33.89,
   "end": 35.847
  },
  {
   "id": "L10",
   "beat": "B5",
   "text": "The night before, engineers had recommended not launching below fifty-three degrees.",
   "start": 36.776,
   "end": 41.457
  },
  {
   "id": "L11",
   "beat": "B5",
   "text": "Their managers reversed that advice, and NASA's top launch officials never heard it.",
   "start": 41.874,
   "end": 46.053
  },
  {
   "id": "L12",
   "beat": "B6",
   "text": "The seal failed in the cold. But the warning failed the night before.",
   "start": 46.853,
   "end": 50.67
  }
 ],
