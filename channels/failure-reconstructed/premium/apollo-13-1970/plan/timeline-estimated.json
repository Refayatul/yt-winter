 "lines": [
  {
   "id": "L1",
   "start": 0.1,
   "end": 4.88,
   "text": "Apollo Thirteen's oxygen tank was already dangerous on the launch pad."
  },
  {
   "id": "L2",
   "start": 5.36,
   "end": 10.55,
   "text": "During ground tests, its heaters were powered from a sixty-five volt supply."
  },
  {
   "id": "L3",
   "start": 11.03,
   "end": 15.35,
   "text": "But its thermostatic switches were rated for twenty-eight volts."
  },
  {
   "id": "L4",
   "start": 15.83,
   "end": 21.53,
   "text": "They were meant to open at eighty degrees, and at sixty-five volts they could not."
  },
  {
   "id": "L5",
   "start": 22.01,
   "end": 28.48,
   "text": "The heater tube may have reached a thousand degrees, damaging the insulation on the fan wires."
  },
  {
   "id": "L6",
   "start": 28.96,
   "end": 36.07,
   "text": "In flight, the crew switched on the tank's fans, and about ninety seconds later the tank lost pressure."
  },
  {
   "id": "L7",
   "start": 36.55,
   "end": 41.8,
   "text": "The board found an electrically initiated fire inside oxygen tank number two."
  },
  {
   "id": "L8",
   "start": 42.28,
   "end": 47.68,
   "text": "It was a near disaster, averted only by the crew and the ground control team."
  },
  {
   "id": "L9",
   "start": 48.16,
   "end": 52.62,
   "text": "The flight was saved in space. The tank was lost on the ground."
  }
 ],
