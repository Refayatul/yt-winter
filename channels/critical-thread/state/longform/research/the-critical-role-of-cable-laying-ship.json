      "role": "evidence",
      "verbatim": false,
      "url": "https://en.wikipedia.org/wiki/Cable_layer",
      "section": "List of cable ships",
      "licence": "CC BY-SA 4.0"
    },
    {
      "id": "C91",
      "text": "In 1901–1902, operated under CS Silvertown for the first trans-Pacific telegraph cable laying.",
