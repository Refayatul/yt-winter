      "licence": "CC BY-SA 4.0"
    },
    {
      "id": "C96",
      "text": "Oersted, named for Hans Christian Ørsted (1872–1922) built for The Great Northern Telegraph Company 1872, was the first ship specifically designed for cable repair.",
      "class": "CONFIRMED_FACT",
