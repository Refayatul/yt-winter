# Bu dosyayi .env olarak kopyalayip kendi anahtarlarinizi yazin.
# Panel > Kaynaklar sekmesinden de girebilirsiniz.

# Senaryo motoru — app.vidiq.com/account/settings/mcp
VIDIQ_KEY=

# Gorsel kaynaklari (istege bagli, hicbiri zorunlu degil)
PEXELS_KEY=
PIXABAY_KEY=
UNSPLASH_KEY=

# --- GORSEL URETIMI (hepsi istege bagli) ---
# Hicbiri yoksa Pollinations kullanilir; o anahtar istemiyor.
CF_ACCOUNT_ID=
CF_API_TOKEN=
TOGETHER_KEY=
HF_TOKEN=

# --- YOUTUBE YUKLEME (istege bagli; yoksa yukleme yapilmaz) ---
# Kurulum ve maliyetler: MALIYET-VE-YETKILER.md
# Her kanal icin ayri OAuth onayi gerekir. Jetonlari ASLA kanallar arasinda
# paylastirmayin. Beklenen kanal kimligi eslesmezse yukleme teknik olarak bloklanir.
# Jeton almak icin:
#   node youtube-yetki.js --channel failure-reconstructed
#   node youtube-yetki.js --channel impossible-brief
#   node youtube-yetki.js --channel critical-thread
#   node youtube-yetki.js --channel behind-the-ordinary
FR_YT_CLIENT_ID=
FR_YT_CLIENT_SECRET=
FR_YT_REFRESH_TOKEN=
FR_YT_CHANNEL_ID=
IB_CLIENT_ID=
IB_CLIENT_SECRET=
IB_YT_REFRESH_TOKEN=
IB_YT_CHANNEL_ID=
CT_CLIENT_ID=
CT_CLIENT_SECRET=
CT_YT_REFRESH_TOKEN=
CT_YT_CHANNEL_ID=
BTO_YT_CLIENT_ID=
BTO_YT_CLIENT_SECRET=
BTO_YT_REFRESH_TOKEN=
BTO_YT_CHANNEL_ID=

# Gecis alias'lari (yeni kurulumda ustteki tercih edilen adlari kullanin):
IB_YT_CLIENT_ID=
IB_YT_CLIENT_SECRET=
CT_YT_CLIENT_ID=
CT_YT_CLIENT_SECRET=

# Geriye uyumluluk: yalnizca Failure Reconstructed bu eski adlari okuyabilir.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_CHANNEL_ID=
# Yukleme gizliligi: private (varsayilan) | unlisted | public
YT_PRIVACY=private
# Kategori (27=Egitim). Liste: YouTube Data API videoCategories.
YT_CATEGORY_ID=27

# --- LONG-FORM CLOUD WRITER (optional; never required for Shorts) ---
# Provider switching is explicit. No fallback is used unless named here.
LONGFORM_LLM_PROVIDER=groq
LONGFORM_LLM_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Safe quota handling: 1–4 attempts, bounded delay in milliseconds.
LONGFORM_LLM_MAX_ATTEMPTS=2
LONGFORM_LLM_MAX_RETRY_MS=30000
# Existing Anthropic provider remains available only when explicitly selected
# as primary/fallback (or through the legacy LONGFORM_LLM=1 configuration).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LONGFORM_LLM=

# --- TIKTOK UPLOAD TO INBOX (public yayin yapmaz) ---
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=

# Watchdog SLA (GitHub repository variable in production).
PRODUCTION_DEADLINE_UTC=16:30

# ProfitDecoded (SHADOW channel; disabled until the enabling checklist in docs/PROFITDECODED.md is complete)
PD_YT_CLIENT_ID=
PD_YT_CLIENT_SECRET=
PD_YT_REFRESH_TOKEN=
PD_YT_CHANNEL_ID=
# Read-only YouTube Data API key for the Competitive Intelligence Engine (no upload scope needed)
PD_YT_API_KEY=
# Publish flags stay UNSET until a human has approved the first videos
# PD_PUBLISH=1
# PD_LONGFORM_PUBLISH=1
# Premium narration (pick ONE; leave unset to use the edge-tts fallback)
# PD_TTS_PROVIDER=google          # google | openai | elevenlabs
# GOOGLE_TTS_API_KEY=             # Cloud Text-to-Speech API key (1M free chars/month, billing must be enabled)
# PD_GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Charon
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# PD_ELEVENLABS_VOICE_ID=

# ProfitDecoded autonomous research + script stages (Claude with web search/fetch)
# ANTHROPIC_API_KEY=
# PD_AUTO_MODEL=claude-opus-5-5
# PD_AUTO_MAX_USD=3              # spend guard per run (estimate)
# PD_AUTO_FALLBACKS=0            # 0 disables server-side refusal fallbacks
# PD_AUTO_PROVIDER=groq            # groq (free tier, GROQ_API_KEY) | anthropic
# PD_AUTO_MAX_TOKENS=400000       # token guard per run (Groq)
# PD_FETCH_CONTACT=you@example.com   # contact e-mail declared in the User-Agent of page downloads (sec.gov REQUIRES an e-mail; set it as a GitHub variable too)
# GROQ_BROWSE_MODEL=openai/gpt-oss-20b   # browsing model (own free-tier quota)
# Web search API for discovery (any ONE; with it research no longer uses Groq's token-hungry browsing):
# SERPER_API_KEY=                 # serper.dev: 2,500 free Google queries on signup, no card
# EXA_API_KEY=                    # exa.ai: free credits every month
# TAVILY_API_KEY=                 # tavily.com (its signup may ask for a card)
# PD_SEARCH_PROVIDER=serper       # optional: force one when several keys exist
# PD_SEARCH_MAX=5                 # searches per topic
# GROQ_LIGHT_MODEL=openai/gpt-oss-20b   # query planning + per-page quote extraction (keeps the main model's daily quota for writing)
